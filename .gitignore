# --- Secrets: never commit ---
.env
.env.*
!.env.example

# --- Vercel CLI local link ---
.vercel

# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- Node ---
node_modules/

# --- Local design mockups (not deployed) ---
build/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db

# --- Call Desk: seller data must never reach this PUBLIC repo ---
# Mailer exports carry owner names, home addresses, personal phone numbers,
# emails and DNC flags. git keeps history forever, so a single accidental
# commit cannot be undone by deleting the file later.
desk/mailers/*
!desk/mailers/README.txt
desk/cache/
desk/logs/
desk/config.json
*.csv
