#!/usr/bin/env bash
# Rebuild site/ and verify, automatically, on every commit.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# Without this you must remember to run build.py yourself, and forgetting it
# produces a commit that reads correctly in the diff but deploys the old page.
# With it, `git commit` is the whole routine. CI still runs the same checks, so
# a clone that never enabled the hook is caught at the pull request.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Nothing to rebuild if the commit does not touch the sources.
if git diff --cached --quiet -- src build.py 2>/dev/null; then
  exit 0
fi

echo "pre-commit: rebuilding site/ from src/"
python3 build.py >/dev/null

git add site

# Drift is impossible here — we just rebuilt and staged — so skip that check
# and let the placeholder and page checks decide.
if ! python3 scripts/check.py --skip-drift; then
  echo
  echo "pre-commit: refusing the commit. Fix the above, then commit again."
  exit 1
fi
